[Unit]
Description=MakerLens private photo detection pilot
After=network.target

[Service]
Type=simple
User=makerlens
Group=makerlens
WorkingDirectory=/opt/makerlens
EnvironmentFile=/etc/makerlens-pilot.env
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/makerlens/venv/bin/python /opt/makerlens/ml/cloud_serve.py --port 8766 --origin ${MAKERLENS_ORIGIN} --goggles /opt/makerlens/models/goggles-v1.pt --gloves /opt/makerlens/models/gloves-v3-cleanstart.pt
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=makerlens
Environment=YOLO_CONFIG_DIR=/var/lib/makerlens
MemoryMax=1400M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
